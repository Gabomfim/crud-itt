# Application Configuration
# Copy this file to .env and modify values as needed

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="CRUD ITT"
APP_VERSION="1.0.0"
APP_DESCRIPTION="A comprehensive FastAPI application with full user management capabilities"
APP_ENVIRONMENT="development"  # development, testing, staging, production
APP_DEBUG="true"

# CORS Configuration
APP_CORS_ORIGINS="*"  # Comma-separated list: http://localhost:3000,https://example.com
APP_CORS_METHODS="GET,POST,PUT,DELETE,PATCH"
APP_CORS_HEADERS="*"

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
DATABASE_URL="sqlite+aiosqlite:///./database/users.db"
DATABASE_ECHO="false"  # Set to true to enable SQL query logging
DATABASE_POOL_SIZE="10"
DATABASE_MAX_OVERFLOW="20"

# For PostgreSQL (uncomment and modify as needed):
# DATABASE_URL="postgresql+asyncpg://username:password@localhost:5432/crud_db"

# For MySQL (uncomment and modify as needed):
# DATABASE_URL="mysql+aiomysql://username:password@localhost:3306/crud_db"

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
LOG_LEVEL="INFO"  # CRITICAL, ERROR, WARNING, INFO, DEBUG
LOG_JSON_LOGS="false"  # Set to true for JSON structured logging (recommended for production)
LOG_LOG_FILE=""  # Optional: path to log file
LOG_MAX_FILE_SIZE="10485760"  # 10MB in bytes
LOG_BACKUP_COUNT="5"

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
SECURITY_SECRET_KEY="your-super-secret-key-change-this-in-production-min-32-chars"
SECURITY_PASSWORD_MIN_LENGTH="8"
SECURITY_PASSWORD_REQUIRE_UPPERCASE="true"
SECURITY_PASSWORD_REQUIRE_LOWERCASE="true"
SECURITY_PASSWORD_REQUIRE_DIGITS="true"
SECURITY_PASSWORD_REQUIRE_SPECIAL="true"
SECURITY_BCRYPT_ROUNDS="12"  # Higher values = more secure but slower

# =============================================================================
# SERVER SETTINGS
# =============================================================================
SERVER_HOST="0.0.0.0"
SERVER_PORT="8000"
SERVER_WORKERS="1"  # Number of worker processes (production only)
SERVER_RELOAD="true"  # Auto-reload for development
SERVER_ACCESS_LOG="true"

# =============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# =============================================================================

# Development
# LOG_LEVEL="DEBUG"
# DATABASE_ECHO="true"
# APP_DEBUG="true"

# Production
# APP_ENVIRONMENT="production"
# LOG_JSON_LOGS="true"
# LOG_LOG_FILE="/var/log/crud-itt/app.log"
# APP_DEBUG="false"
# DATABASE_ECHO="false"
# SERVER_RELOAD="false"
# SERVER_WORKERS="4"

# Testing
# APP_ENVIRONMENT="testing"
# DATABASE_URL="sqlite+aiosqlite:///:memory:"
# LOG_LEVEL="WARNING"